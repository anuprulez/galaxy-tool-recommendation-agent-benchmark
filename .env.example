# OpenAI API key (used by the LLM evaluation runner / prediction generators)
OPENAI_API_KEY=replace-with-key

# Optional Galaxy API key (used if you pass --use-bioblend to the catalog builder).
# usegalaxy.org does not require a key for /api/tools, but other servers might.
# GALAXY_API_KEY=replace-with-key

# Optional dataset size cap (bytes). Tutorials whose datasets exceed this are skipped.
# Example: 1GB = 1073741824
# MAX_DATASET_BYTES=1073741824
